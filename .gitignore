# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.venv/
venv/
ENV/
env/

# Data & Models
data/raw/*
data/processed/*
data/features/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep
models/*.pkl
models/*.h5
models/*.pth
!models/.gitkeep

# Uploads & Temp
app/static/uploads/*
!app/static/uploads/.gitkeep
temp/
*.log

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
